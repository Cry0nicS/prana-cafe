{
    "name": "prana-cafe",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "clean": "npx nuxi cleanup && rm -rf node_modules/ && rm -rf .nuxt/ && rm package-lock.json",
        "dev": "nuxt dev",
        "format": "prettier --write **/*.{js,json,jsx,css,ts,tsx,vue}",
        "format-check": "prettier --check \"**/*.{html,js,json,jsx,css,ts,tsx,vue,scss}\"",
        "generate": "nuxt generate",
        "lint": "eslint .",
        "postinstall": "nuxt prepare",
        "prepare": "simple-git-hooks",
        "preview": "nuxt preview",
        "type-check": "nuxt typecheck"
    },
    "dependencies": {
        "@googlemaps/places": "^2.2.0",
        "@nuxt/eslint": "^1.12.1",
        "@nuxt/image": "^2.0.0",
        "@nuxt/scripts": "^0.13.2",
        "@nuxt/ui": "^4.3.0",
        "@nuxtjs/i18n": "^10.2.1",
        "@nuxtjs/seo": "^3.3.0",
        "@nuxtjs/supabase": "^2.0.1",
        "@unhead/vue": "^2.1.2",
        "eslint": "^9.39.2",
        "mailgun.js": "^12.6.1",
        "nuxt": "^4.2.2",
        "rollbar": "^2.26.5",
        "typescript": "^5.9.3",
        "vue": "^3.5.27",
        "vue-router": "^5.0.0",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^7.0.1",
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "@iconify-json/lucide": "^1.2.86",
        "@iconify-json/mdi": "^1.2.3",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "simple-git-hooks": "^2.13.1",
        "vue-tsc": "^3.2.2"
    },
    "simple-git-hooks": {
        "commit-msg": "npx commitlint --edit \"$1\"",
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{html,js,json,css,ts,vue}": "prettier --check",
        "*.{js,ts,vue}": "eslint"
    }
}
